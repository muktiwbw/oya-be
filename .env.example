# Runtime settings for make run, make migrate, and the oya binary.
# Process environment variables override these values.
OYA_HTTP_ADDR=:8080
DB_HOST=localhost
DB_PORT=15432
DB_NAME=oya
DB_USER=postgres
DB_PASSWORD=postgres
OYA_JWT_SECRET=oya-dev-secret-change-in-production-min-32-chars
OYA_JWT_EXPIRATION=15m
OYA_REFRESH_TTL=720h
OYA_GOOGLE_CLIENT_ID=
OYA_GOOGLE_CLIENT_SECRET=
OYA_GOOGLE_REDIRECT_URL=http://localhost:5173/api/v1/auth/google/callback
OYA_GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:5173/auth/callback
OYA_REFRESH_COOKIE_SECURE=false
OYA_LOG_LEVEL=info
OYA_SHUTDOWN_TIMEOUT=10s
OYA_REQUEST_BODY_LIMIT=65536
OYA_IDEMPOTENCY_TTL=24h
